#!/usr/bin/env bash
set -euo pipefail

status=0

while IFS= read -r path; do
  printf 'test file under src: %s\n' "$path" >&2
  status=1
done < <(
  find crates -path '*/src/*' -type f \
    \( -name 'tests.rs' -o -name '*_tests.rs' -o -name '*-tests.rs' -o -name '*_test.rs' \) \
    -print | sort
)

if matches=$(rg -n '#\[(?:[A-Za-z_][A-Za-z0-9_]*::)?(?:test|rstest)' crates/*/src --glob '*.rs'); then
  printf '%s\n' "$matches" >&2
  status=1
fi

if matches=$(rg -n -U '#\[cfg\([^\n]*\btest\b[^\n]*\)\]\n(?:#\[[^\n]+\]\n)*(?:pub(?:\([^)]*\))? )?mod [A-Za-z_][A-Za-z0-9_]*\s*\{' crates/*/src --glob '*.rs'); then
  printf '%s\n' "$matches" >&2
  status=1
fi

if matches=$(rg -n -U '#\[cfg\([^\n]*\btest\b[^\n]*\)\]\n(?:pub(?:\([^)]*\))? )?mod [A-Za-z_][A-Za-z0-9_]*\s*;' crates/*/src --glob '*.rs'); then
  printf '%s\n' "$matches" >&2
  status=1
fi

exit "$status"
