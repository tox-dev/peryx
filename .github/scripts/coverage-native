#!/usr/bin/env bash
set -euo pipefail

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo"
requested_output=${1:-.tox/coverage/native.lcov}
output_parent=$(dirname -- "$requested_output")
mkdir -p "$output_parent"
output_parent=$(cd "$output_parent" && pwd -P)
output="$output_parent/$(basename -- "$requested_output")"
contract_output="$output_parent/$(basename -- "${requested_output%.*}.contracts")"
rm -f "$output"
rm -rf "$contract_output"
session=$(mktemp -d "$output_parent/.${output##*/}.session.XXXXXX")
staged_output="$session/${output##*/}"
staged_contracts="$session/${contract_output##*/}"
published=0
cleanup() {
  rm -rf "$session"
  if ((!published)); then
    rm -f "$output"
    rm -rf "$contract_output"
  fi
}
trap cleanup EXIT
packages=()
while IFS= read -r package; do
  packages+=("$package")
done < <(scripts/ci/workspace-package-list contracts)
.github/scripts/crate-contracts "$session/crates" "${packages[@]}"
.github/scripts/coverage-combine "$staged_output" "$session/crates"/*.lcov
mkdir "$staged_contracts"
cp "$session/crates"/*.lcov "$session/crates"/*.contract.json "$staged_contracts/"
mv "$staged_output" "$output"
mv "$staged_contracts" "$contract_output"
published=1
