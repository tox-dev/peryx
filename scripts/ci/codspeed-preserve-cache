#!/usr/bin/env bash
set -euo pipefail

current=${1:?current key is required}
restored=${2:?restored key is required}
sources=.tox/codspeed/target/codspeed-sources
if [[ -f $sources ]]; then
    comm -z -12 \
        <(sort -z "$sources") \
        <(git ls-files -s -z -- .cargo crates Cargo.lock Cargo.toml rust-toolchain.toml | sort -z) \
        | cut -z -f2 \
        | xargs -0 -r touch --date=@0 --
elif [[ "$restored" == "$current" ]]; then
    git ls-files -z -- .cargo crates Cargo.lock Cargo.toml rust-toolchain.toml \
        | xargs -0 touch --date=@0 --
fi
