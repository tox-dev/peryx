#!/usr/bin/env bash
set -euo pipefail

event=${1:?event is required}
runner=${2:?runner state is required}
shared=${3:?shared state is required}
shift 3

changes='{}'
positional=()
named_count=0
while (($#)); do
  case $1 in
    --change)
      pair=${2:?change requires key=state}
      key=${pair%%=*}
      state=${pair#*=}
      if [[ $key == "$pair" || -z $key || ($state != true && $state != false) ]]; then
        printf 'change must use key=true or key=false: %s\n' "$pair" >&2
        exit 2
      fi
      changes=$(jq -c --arg key "$key" --arg state "$state" '. + {($key): $state}' <<<"$changes")
      ((named_count += 1))
      shift 2
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

metadata=$(cargo metadata --no-deps --format-version 1)
legs=$(jq -c '
  [.packages[]
    | select(.metadata["peryx-ci"].codspeed != null)
    | {
        ecosystem: .metadata["peryx-ci"].codspeed.label,
        package: .name,
        cargo_jobs: .metadata["peryx-ci"].codspeed["cargo-jobs"],
        change_key: .metadata["peryx-ci"].codspeed["change-key"],
        order: .metadata["peryx-ci"].codspeed.order,
        benches: .metadata["peryx-ci"].codspeed.benches,
        runner_fallback: (.metadata["peryx-ci"].codspeed["runner-fallback"] // false)
      }]
  | sort_by(.order)
' <<<"$metadata")

if ! jq -e '
  length > 0
  and all(.[];
    (.ecosystem | type) == "string" and (.ecosystem | length) > 0
    and (.package | type) == "string" and (.package | length) > 0
    and (.cargo_jobs | type) == "number" and .cargo_jobs == (.cargo_jobs | floor) and .cargo_jobs > 0
    and (.change_key | type) == "string" and (.change_key | length) > 0
    and (.order | type) == "number" and .order == (.order | floor) and .order >= 0
    and (.benches | type) == "array" and all(.benches[]; type == "string" and length > 0)
    and ([.benches[]] | unique | length) == (.benches | length)
    and (.runner_fallback | type) == "boolean"
  )
  and ([.[].order] | unique | length) == length
  and ([.[].change_key] | unique | length) == length
  and ([.[] | select(.runner_fallback)] | length) == 1
' <<<"$legs" >/dev/null; then
  printf 'CodSpeed metadata has invalid or duplicate matrix fields\n' >&2
  exit 2
fi

if ((${#positional[@]})); then
  if ((named_count)); then
    printf 'use positional states or --change states, not both\n' >&2
    exit 2
  fi
  if ((${#positional[@]} != $(jq 'length' <<<"$legs"))); then
    printf 'CodSpeed owner count does not match the change-state arguments\n' >&2
    exit 2
  fi
  index=0
  for state in "${positional[@]}"; do
    if [[ $state != true && $state != false ]]; then
      printf 'change state must be true or false: %s\n' "$state" >&2
      exit 2
    fi
    key=$(jq -r --argjson index "$index" '.[$index].change_key' <<<"$legs")
    changes=$(jq -c --arg key "$key" --arg state "$state" '. + {($key): $state}' <<<"$changes")
    ((index += 1))
  done
fi
if ((named_count && named_count != $(jq 'keys | length' <<<"$changes"))); then
  printf 'change keys must be unique\n' >&2
  exit 2
fi
if ! jq -e --argjson legs "$legs" '
  ([keys[]] - [$legs[].change_key]) == []
  and ([$legs[].change_key] - [keys[]]) == []
' <<<"$changes" >/dev/null; then
  printf 'change states must name every CodSpeed owner\n' >&2
  exit 2
fi

jq -cn \
  --arg event "$event" \
  --arg runner "$runner" \
  --arg shared "$shared" \
  --argjson changes "$changes" \
  --argjson legs "$legs" '
  def output: map({ecosystem, package, cargo_jobs});
  if $event == "push" or $event == "workflow_dispatch" or $shared == "true" then
    $legs | output
  else
    [$legs[] | select($changes[.change_key] == "true")] as $selected
    | if ($selected | length) == 0 and $runner == "true" then
        [$legs[] | select(.runner_fallback)] | output
      else
        $selected | output
      end
  end
'
