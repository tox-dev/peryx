#!/usr/bin/env bash
set -euo pipefail

scope=${1:-normal}
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)

remove_paths() {
  (($#)) && rm -rf -- "$@"
}

clean_coverage() {
  local target
  for target in \
    "$repo/.tox/coverage-target" \
    "$repo/.tox/crate-contracts/target" \
    "$repo/.tox/fuzz-target"; do
    [[ -d $target ]] || continue
    find "$target" -type f \
      \( -name '*.profraw' -o -name '*.profdata' -o -name '*-profraw-list' \) -delete
  done

  local outputs=(
    "$repo/.tox/coverage"
    "$repo/.tox/coverage-sessions"
    "$repo/lcov.contracts"
    "$repo/lcov.info"
    "$repo/coverage-availability.lcov"
    "$repo/coverage-e2e-live.lcov"
    "$repo/coverage-e2e.lcov"
    "$repo/coverage-frontend-native.lcov"
    "$repo/coverage-frontend-wasm.lcov"
    "$repo/coverage-frontend.lcov"
    "$repo/coverage-native.contracts"
    "$repo/coverage-native.lcov"
    "$repo/coverage-simulation.lcov"
    "$repo/coverage-system-clients.lcov"
    "$repo/coverage-system-distributed.lcov"
  )
  if [[ -d $repo/.tox/crate-contracts ]]; then
    while IFS= read -r -d '' output; do
      outputs+=("$output")
    done < <(find "$repo/.tox/crate-contracts" -mindepth 1 -maxdepth 1 ! -name target -print0)
  fi
  remove_paths "${outputs[@]}"
}

clean_transient() {
  bash "$repo/scripts/ci/compose-run" clean
  remove_paths \
    "$repo/.tox/bench/scratch" \
    "$repo/.tox/docker/tmp" \
    "$repo/.tox/frontend/oci" \
    "$repo/.tox/frontend/pypi" \
    "$repo/.tox/frontend/shared" \
    "$repo/.tox/frontend/ui" \
    "$repo/.tox/hawk/graph" \
    "$repo/.tox/site" \
    "$repo/.tox/tmp" \
    "$repo/crates/peryx-ecosystem-oci/tests/frontend/blob-report" \
    "$repo/crates/peryx-ecosystem-oci/tests/frontend/playwright-report" \
    "$repo/crates/peryx-ecosystem-oci/tests/frontend/test-results" \
    "$repo/crates/peryx-ecosystem-pypi/tests/frontend/blob-report" \
    "$repo/crates/peryx-ecosystem-pypi/tests/frontend/playwright-report" \
    "$repo/crates/peryx-ecosystem-pypi/tests/frontend/test-results" \
    "$repo/target-browser" \
    "$repo/crates/peryx-web/tests/frontend/blob-report" \
    "$repo/crates/peryx-web/tests/frontend/playwright-report" \
    "$repo/crates/peryx-web/tests/frontend/test-results" \
    "$repo/ui"
}

case $scope in
  coverage)
    clean_coverage
    ;;
  normal)
    clean_coverage
    clean_transient
    ;;
  all)
    clean_coverage
    clean_transient
    remove_paths \
      "$repo/.tox/codspeed" \
      "$repo/.tox/coverage-target" \
      "$repo/.tox/docker" \
      "$repo/.tox/frontend" \
      "$repo/.tox/fuzz" \
      "$repo/.tox/fuzz-runs" \
      "$repo/.tox/fuzz-target" \
      "$repo/.tox/hawk" \
      "$repo/.tox/pre-commit-target" \
      "$repo/.tox/tools" \
      "$repo/crates/peryx-ecosystem-oci/tests/frontend/node_modules" \
      "$repo/crates/peryx-ecosystem-pypi/tests/frontend/node_modules" \
      "$repo/crates/peryx-web/dist" \
      "$repo/site/node_modules" \
      "$repo/site/public" \
      "$repo/target" \
      "$repo/crates/peryx-web/tests/frontend/node_modules"
    ;;
  *)
    printf 'unknown cleanup scope: %s\n' "$scope" >&2
    exit 2
    ;;
esac
